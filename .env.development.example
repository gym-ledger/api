
NODE_ENV=development
PORT=4000

DATABASE_USER=workout_gym_api_user
DATABASE_PASSWORD=generated-by-openssl-rand-hex-32
DATABASE_NAME=workout_gym_api_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
REDIS_URL=redis://localhost:6379

# TOKENS
ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
ADMIN_ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
LOG_LEVEL=debug
# Optional universal login OTP (6 digits) for dev/testing. Leave unset to disable any OTP bypass.
# MASTER_LOGIN_OTP=

# ── Browser access ───────────────────────────────────────────────────────────
# Comma-separated origins of the user app and admin panel (no trailing slash).
# Unset in development = any origin allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Refresh tokens are kept in an httpOnly cookie.
#   COOKIE_SECURE   defaults to true in production. Set false ONLY if the API is
#                   served over plain http, or browsers will drop the cookie.
#   COOKIE_SAMESITE strict (default) or lax when the front-ends share a site with
#                   the API (app.example.com + api.example.com, or one host on
#                   different ports); none when they are on unrelated domains
#                   (requires https).
#   COOKIE_DOMAIN   leave unset unless you know you need it.
# COOKIE_SECURE=
# COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=

# ── OTP delivery ─────────────────────────────────────────────────────────────
# Product name used in OTP emails.
APP_NAME="Gym Ledger"
# Email codes via Resend (https://resend.com). EMAIL_FROM must use a domain
# verified in Resend.
# Unset in development = codes are only logged to the console.
RESEND_API_KEY=
EMAIL_FROM=
# Phone codes via WhatsApp (Twilio). false = phone numbers sign in with a
# password only, and the apps hide "Send code" for them. When true, set
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_CONTENT_SID (an
# approved WhatsApp authentication template whose {{1}} is the code) and
# either TWILIO_WHATSAPP_FROM (+E.164 sender) or TWILIO_MESSAGING_SERVICE_SID.
PHONE_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_CONTENT_SID=

# ── AI weekly check-ins ──────────────────────────────────────────────────────
# Groq API key (https://console.groq.com). Unset = the Home check-in card shows
# the week's numbers without the written coach note.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_DAILY_REQUEST_LIMIT=900

# ── CAPTCHA on "send code" ───────────────────────────────────────────────────
# altcha = self-hosted proof-of-work (nothing sent to a third party), or none.
# Use none when testing from a phone over plain http on your LAN: the widget
# needs a secure context (https or localhost).
CAPTCHA_PROVIDER=altcha
# Optional in development (derived from ACCESS_TOKEN_SECRET when unset).
# CAPTCHA_SECRET=

# ── Exercise images (S3-compatible storage) ──────────────────────────────────
# Any S3-compatible provider: Cloudflare R2, AWS S3, MinIO, Backblaze B2, ...
# Leave S3_BUCKET empty to turn image uploads off (the admin panel then gets a
# clear error if someone tries to upload one).
# Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com,
# S3_REGION=auto, an R2 API token with Object Read & Write on the bucket, and
# S3_PUBLIC_URL = the bucket's public URL (r2.dev or a custom domain).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# true for MinIO and other providers that need path-style URLs.
# S3_FORCE_PATH_STYLE=false
