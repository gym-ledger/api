
NODE_ENV=production
PORT=4000

DEPLOY_MODE=with-db

# Postgres container superuser — used by the postgres Docker image on first init
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generated-by-openssl-rand-hex-32
POSTGRES_DB=postgres

# App DB credentials — DATABASE_PASSWORD is also used by init.sh to create the app user
DATABASE_USER=workout_gym_api_user
DATABASE_PASSWORD=generated-by-openssl-rand-hex-32
DATABASE_NAME=workout_gym_api_db
# with-db mode: postgres  |  api-only mode: host.docker.internal
DATABASE_HOST=postgres
DATABASE_PORT=5432
# Literal URL — dotenv does not expand variables; keep in sync with the vars above
DATABASE_URL=postgresql://workout_gym_api_user:generated-by-openssl-rand-hex-32@postgres:5432/workout_gym_api_db

# with-db mode: the redis container requires REDIS_PASSWORD; generate-secrets.sh fills both lines in
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
# api-only mode: redis://host.docker.internal:6379 (add :<password>@ if your host Redis has one)
REDIS_PASSWORD=generated-by-openssl-rand-hex-32
REDIS_URL=redis://:generated-by-openssl-rand-hex-32@redis:6379

# TOKENS
ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
ADMIN_ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
LOG_LEVEL=info

# First admin account, created on container start (npm run seed:admin).
# Both are required in production: set the email to your own address;
# generate-secrets.sh fills in a random password.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=generated-by-openssl-rand-hex-32

# ── Browser access ───────────────────────────────────────────────────────────
# Comma-separated origins of the user app and admin panel (no trailing slash).
# Required in production, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=
# Refresh tokens are kept in an httpOnly cookie.
#   COOKIE_SECURE   defaults to true in production. Set false ONLY if the API is
#                   served over plain http, or browsers will drop the cookie.
#   COOKIE_SAMESITE strict (default) or lax when the front-ends share a site with
#                   the API (app.example.com + api.example.com, or one host on
#                   different ports); none when they are on unrelated domains
#                   (requires https).
#   COOKIE_DOMAIN   leave unset unless you know you need it.
# COOKIE_SECURE=
# COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=

# ── OTP delivery ─────────────────────────────────────────────────────────────
# Product name used in OTP emails.
APP_NAME="Gym Ledger"
# Email codes via Resend (https://resend.com). EMAIL_FROM must use a domain
# verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Phone codes via WhatsApp (Twilio). false = phone numbers sign in with a
# password only, and the apps hide "Send code" for them. When true, set
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_CONTENT_SID (an
# approved WhatsApp authentication template whose {{1}} is the code) and
# either TWILIO_WHATSAPP_FROM (+E.164 sender) or TWILIO_MESSAGING_SERVICE_SID.
PHONE_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_CONTENT_SID=

# ── AI weekly check-ins ──────────────────────────────────────────────────────
# Groq API key (https://console.groq.com). Unset = the Home check-in card shows
# the week's numbers without the written coach note. See
# algorithms/weekly-checkin.md.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_DAILY_REQUEST_LIMIT=900

# ── CAPTCHA on "send code" ───────────────────────────────────────────────────
# altcha = self-hosted proof-of-work (nothing sent to a third party), or none.
CAPTCHA_PROVIDER=altcha
# Signs ALTCHA challenges. Required in production; generate-secrets.sh fills it in.
CAPTCHA_SECRET=generated-by-openssl-rand-hex-32
