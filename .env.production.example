
NODE_ENV=production
PORT=4000

DEPLOY_MODE=with-db

# Postgres container superuser — used by the postgres Docker image on first init
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generated-by-openssl-rand-hex-32
POSTGRES_DB=postgres

# App DB credentials — DATABASE_PASSWORD is also used by init.sh to create the app user
DATABASE_USER=workout_gym_api_user
DATABASE_PASSWORD=generated-by-openssl-rand-hex-32
DATABASE_NAME=workout_gym_api_db
# with-db mode: postgres  |  api-only mode: host.docker.internal
DATABASE_HOST=postgres
DATABASE_PORT=5432
# Literal URL — dotenv does not expand variables; keep in sync with the vars above
DATABASE_URL=postgresql://workout_gym_api_user:generated-by-openssl-rand-hex-32@postgres:5432/workout_gym_api_db

# with-db mode: the redis container requires REDIS_PASSWORD; generate-secrets.sh fills both lines in
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379
# api-only mode: redis://host.docker.internal:6379 (add :<password>@ if your host Redis has one)
REDIS_PASSWORD=generated-by-openssl-rand-hex-32
REDIS_URL=redis://:generated-by-openssl-rand-hex-32@redis:6379

# TOKENS
ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
ADMIN_ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
LOG_LEVEL=info

# First admin account, created on container start (npm run seed:admin).
# Both are required in production: set the email to your own address;
# generate-secrets.sh fills in a random password.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=generated-by-openssl-rand-hex-32

# ── Browser access ───────────────────────────────────────────────────────────
# Comma-separated origins of the user app and admin panel (no trailing slash).
# Required in production, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=
# Refresh tokens are kept in an httpOnly cookie.
#   COOKIE_SECURE   defaults to true in production. Set false ONLY if the API is
#                   served over plain http, or browsers will drop the cookie.
#   COOKIE_SAMESITE strict (default) or lax when the front-ends share a site with
#                   the API (app.example.com + api.example.com, or one host on
#                   different ports); none when they are on unrelated domains
#                   (requires https).
#   COOKIE_DOMAIN   leave unset unless you know you need it.
# COOKIE_SECURE=
# COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=

# ── OTP delivery ─────────────────────────────────────────────────────────────
# Product name used in OTP emails.
APP_NAME="Gym Ledger"
# Email codes via Resend (https://resend.com). EMAIL_FROM must use a domain
# verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Phone codes via WhatsApp (Twilio). false = phone numbers sign in with a
# password only, and the apps hide "Send code" for them. When true, set
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_CONTENT_SID (an
# approved WhatsApp authentication template whose {{1}} is the code) and
# either TWILIO_WHATSAPP_FROM (+E.164 sender) or TWILIO_MESSAGING_SERVICE_SID.
PHONE_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_CONTENT_SID=

# ── AI weekly check-ins ──────────────────────────────────────────────────────
# Groq API key (https://console.groq.com). Unset = the Home check-in card shows
# the week's numbers without the written coach note.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_DAILY_REQUEST_LIMIT=900

# ── CAPTCHA on "send code" ───────────────────────────────────────────────────
# altcha = self-hosted proof-of-work (nothing sent to a third party), or none.
CAPTCHA_PROVIDER=altcha
# Signs ALTCHA challenges. Required in production; generate-secrets.sh fills it in.
CAPTCHA_SECRET=generated-by-openssl-rand-hex-32

# ── Exercise images (S3-compatible storage) ──────────────────────────────────
# Any S3-compatible provider: Cloudflare R2, AWS S3, MinIO, Backblaze B2, ...
# Leave S3_BUCKET empty to turn image uploads off (the admin panel then gets a
# clear error if someone tries to upload one).
# Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com,
# S3_REGION=auto, an R2 API token with Object Read & Write on the bucket, and
# S3_PUBLIC_URL = the bucket's public URL (r2.dev or a custom domain).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# true for MinIO and other providers that need path-style URLs.
# S3_FORCE_PATH_STYLE=false

# ── Database backups (deployment/BACKUPS.md) ─────────────────────────────────
# Nightly: every database + roles, dumped, checked, encrypted with age and
# uploaded. A SEPARATE bucket from exercise images (S3_* above), ideally with
# its own API token that can only write to it. Leave BACKUP_S3_BUCKET empty
# to keep backups off.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Folder inside the bucket.
# BACKUP_S3_PREFIX=postgres
# Public key from `age-keygen` (age1...). Backups are encrypted to it; keep the
# matching private key OFF this server. Without it, backups don't run.
BACKUP_AGE_RECIPIENT=
# Cron schedule, in the container's time zone (UTC unless TZ is set).
# BACKUP_SCHEDULE=30 3 * * *
# Days kept. At most 30: the privacy policy promises deleted data leaves backups within 30 days.
# BACKUP_RETENTION_DAYS=30
# Optional healthchecks.io-style URL pinged on start (/start), success, and failure (/fail).
# BACKUP_PING_URL=
# true = also run one backup whenever the container starts (handy to test the setup).
# BACKUP_RUN_ON_START=false
# api-only mode only: a superuser login to your own Postgres server.
# BACKUP_PGHOST=host.docker.internal
# BACKUP_PGPORT=5432
# BACKUP_PGUSER=
# BACKUP_PGPASSWORD=

# ── Live standby (optional, with-db mode; deployment/BACKUPS.md) ─────────────
# A copy of the database on a second server, kept up to date continuously.
# Needs a private network between the two servers (Tailscale/WireGuard).
# Can be turned on or off at any time; the database is never restarted for it.
REPLICATION_ENABLED=false
# This server's PRIVATE address (e.g. its Tailscale IP, 100.x.y.z) and the
# port the standby connects to. Public addresses are refused.
REPLICATION_BIND_IP=
REPLICATION_PORT=5433
REPLICATION_USER=replicator
REPLICATION_PASSWORD=
REPLICATION_SLOT=gym_ledger_standby
# Most WAL kept for a standby that is offline; past it, the standby must be re-copied.
# REPLICATION_MAX_WAL_KEEP=4GB

# ── Monitoring (optional; deployment/monitoring/MONITORING.md) ───────────────
# Prometheus + Grafana on this server, plus the admin panel's "API" page.
# Remove "monitoring" to run without them (the API still serves metrics on
# METRICS_PORT and logs errors/slow requests to Postgres).
COMPOSE_PROFILES=monitoring
# METRICS_ENABLED=true
# METRICS_PORT=9464
# Requests this slow (ms) are kept in api_request_issues, as are all errors.
# REQUEST_LOG_SLOW_MS=500
# REQUEST_LOG_RETENTION_DAYS=30
# Lets the admin API page show latency percentiles. Inside Docker:
PROMETHEUS_URL=http://prometheus:9090
# PROMETHEUS_RETENTION=30d
# PROMETHEUS_RETENTION_SIZE=2GB
# Where you open Grafana (shown as a link in the admin panel). Over an SSH
# tunnel: http://localhost:3002. Behind Cloudflare Access: https://grafana.example.com
GRAFANA_URL=http://localhost:3002
# Required when monitoring is on; Grafana won't start without it. Only
# applied on Grafana's first start.
GRAFANA_ADMIN_PASSWORD=
# Alert emails. Leave ALERT_EMAIL_TO empty for dashboards only.
ALERT_EMAIL_TO=
GRAFANA_SMTP_ENABLED=false
# Resend: host smtp.resend.com:587, user "resend", password = a Resend API key.
# GRAFANA_SMTP_HOST=smtp.resend.com:587
# GRAFANA_SMTP_USER=resend
GRAFANA_SMTP_PASSWORD=
# A sender on a domain verified in Resend, e.g. alerts@example.com
GRAFANA_SMTP_FROM=
# Optional Cloudflare Tunnel for Grafana: add ",cloudflare-tunnel" to
# COMPOSE_PROFILES and paste the tunnel's token here.
# CLOUDFLARE_TUNNEL_TOKEN=
