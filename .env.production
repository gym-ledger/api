
NODE_ENV=production
PORT=4000

DEPLOY_MODE=with-db

# Postgres container superuser — used by the postgres Docker image on first init
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generated-by-openssl-rand-hex-32
POSTGRES_DB=postgres

# App DB credentials — DATABASE_PASSWORD is also used by init.sh to create the app user
DATABASE_USER=workout_gym_api_user
DATABASE_PASSWORD=generated-by-openssl-rand-hex-32
DATABASE_NAME=workout_gym_api_db
# with-db mode: postgres  |  api-only mode: host.docker.internal
DATABASE_HOST=postgres
DATABASE_PORT=5432
# Literal URL — dotenv does not expand variables; keep in sync with the vars above
DATABASE_URL=postgresql://workout_gym_api_user:generated-by-openssl-rand-hex-32@postgres:5432/workout_gym_api_db

# with-db mode: redis://redis:6379  |  api-only mode: redis://host.docker.internal:6379
REDIS_URL=redis://redis:6379

# TOKENS
ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
ADMIN_ACCESS_TOKEN_SECRET=generated-by-openssl-rand-hex-32
LOG_LEVEL=info

# Default admin credentials — change before first deploy if desired
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=admin@admin.com
