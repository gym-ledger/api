{
  "name": "gym-ledger-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "migrate": "tsx src/scripts/run-migrations.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:exercises": "tsx src/scripts/seed-exercises.ts",
    "seed:load-users": "tsx src/scripts/seed-load-users.ts",
    "export:exercises": "tsx src/scripts/export-exercises.ts",
    "recompute:muscle-signals": "tsx src/scripts/recompute-muscle-signals.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "altcha-lib": "2.7.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "luxon": "^3.7.2",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "15.1.3",
    "redis": "^5.12.1",
    "sharp": "0.35.5",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@types/pino-http": "^5.8.4",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
