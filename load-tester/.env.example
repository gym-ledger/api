# Password of the seeded load-test accounts: the same value the API's seed-load-users used.
LOAD_USER_PASSWORD=

# Same value as the API's LOAD_TEST_SECRET. Lets each simulated user have its own rate-limit
# bucket; without it everyone shares this machine's IP and gets throttled.
LOAD_TEST_SECRET=

# The config the generator runs (docker compose / pm2).
LOAD_CONFIG=configs/soak-forever.json

# Dashboard port on this machine (localhost only).
LOAD_UI_PORT=8099
# Optional basic-auth password for the dashboard (only matters if you expose it beyond localhost).
# LOAD_UI_PASSWORD=
